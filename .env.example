# 服务监听地址。本地开发用 127.0.0.1，服务器上由 Nginx 反代，保持 127.0.0.1 即可
HOST=127.0.0.1

# 服务端口
PORT=8000

# SQLite 数据库文件路径，相对项目根目录
DB_PATH=data/clips.db

# 每期学习 HTML 所在目录，相对项目根目录
CONTENT_DIR=content

# 触发 POST /api/scan 所需的令牌。部署到服务器前必须改成随机长字符串
ADMIN_TOKEN=

# 可选。设置后全站启用 HTTP Basic 认证，用户名留空，密码填这里。不设置则不启用
SITE_PASSWORD=

# 「补充」写入口令。设置后浏览器里输一次即可保存补充；请求头 X-Notes-Password 必须等于该值。
# 不设置则保存补充的请求一律拒绝（前端按钮也会禁用）
NOTES_PASSWORD=

# 仅预览用。置 1 后可以用 ?today=YYYY-MM-DD 覆盖「今天」，便于查看某一天的页面（例如周日的复盘视图）。
# 预览模式下只读、不写库；用 ?today=off 退出。正式运行时保持空
ALLOW_TODAY_OVERRIDE=
